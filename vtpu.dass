# ═══════════════════════════════════════════════════════════════════════════
# Collection 7: Design
# ═══════════════════════════════════════════════════════════════════════════

[design:three-pipe]
coordinate: 1.1.1/7.1.1/1.1.1
name: D/S/C Three-Pipe Architecture
description: |
  Dense (D): ALU operations on register values
  Sparse (S): Memory gather/scatter via coordinates  
  Coord (C): Coordinate arithmetic and navigation
insight: "Three pipes retire simultaneously for 3 ops/cycle"

[design:siw]
coordinate: 1.1.2/7.1.1/1.1.1
name: Single Instruction Word
description: |
  Packed instruction containing D, S, C operations plus coordinate
  Each SIW specifies work for all three pipes
  Scheduler ensures no port conflicts

[design:ppt]
coordinate: 1.1.3/7.1.1/1.1.1
name: Phext Page Table
description: |
  Translates 11D coordinates to flat physical addresses
  Z-order curve for inner dimensions (L1 locality)
  Hierarchical grouping for outer dimensions
  PTC achieves >85% hit rate on structured workloads

[design:epoch]
coordinate: 1.1.4/7.1.1/1.1.1
name: Epoch-Structured Memory
description: |
  All translations resolved against immutable EpochView
  Copy-on-write persistence, no mutation of history
  Fork creates new futures by pointer divergence
  History is constant, translation is referentially stable

