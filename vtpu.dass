# vtpu.dass — Virtual TPU Self-Specification
# Coordinate: 1.1.1/1.1.1/1.1.1
# Format: Dimensionally-aware Software System

# ═══════════════════════════════════════════════════════════════════════════
# Collection 1: Meta
# ═══════════════════════════════════════════════════════════════════════════

[meta:vtpu]
coordinate: 1.1.1/1.1.1/1.1.1
version: 0.35.0
name: Virtual Tensor Processing Unit
description: Software-defined AI accelerator achieving 3 ops/cycle on commodity AMD hardware
substrate: phext
backend: sq
status: R23W35

[inputs]
- phext coordinates (11D)
- SIW instruction streams
- sentron register state
- memory regions

[outputs]
- computed results
- telemetry
- epoch state
- coordinate translations

# ═══════════════════════════════════════════════════════════════════════════
# Collection 2: Requirements
# ═══════════════════════════════════════════════════════════════════════════

[req:core-throughput]
coordinate: 1.1.1/2.1.1/1.1.1
id: REQ-001
description: Achieve 3 operations per CPU cycle sustained
source: R23 Rally Specification
priority: critical
status: in-progress

[req:coordinate-addressing]
coordinate: 1.1.2/2.1.1/1.1.1
id: REQ-002
description: All memory access via 11D phext coordinates
source: phext specification
priority: critical
status: complete

[req:epoch-consistency]
coordinate: 1.1.3/2.1.1/1.1.1
id: REQ-003
description: Referentially stable translations across epochs
source: R23W30 Bootloader
priority: high
status: complete

[req:single-node-75gops]
coordinate: 1.1.4/2.1.1/1.1.1
id: REQ-004
description: 75 Gops/sec on single AMD R9 node
source: R23 Phase 3 target
priority: high
status: pending

# ═══════════════════════════════════════════════════════════════════════════
# Collection 3: Use Cases
# ═══════════════════════════════════════════════════════════════════════════

[usecase:inference]
coordinate: 1.1.1/3.1.1/1.1.1
id: UC-001
name: LLM Inference
actor: Application
flow:
  1. Application submits prompt
  2. vTPU loads model weights from coordinates
  3. vTPU executes inference pipeline
  4. vTPU returns generated tokens
postcondition: 75-150 tokens/second

[usecase:coordinate-translation]
coordinate: 1.1.2/3.1.1/1.1.1
id: UC-002
name: Coordinate Translation
actor: Internal
flow:
  1. Instruction references phext coordinate
  2. PPT translates to physical address
  3. PTC caches hot translations
postcondition: O(1) translation, >85% PTC hit rate

[usecase:sentron-execution]
coordinate: 1.1.3/3.1.1/1.1.1
id: UC-003
name: Sentron Batch Execution
actor: Scheduler
flow:
  1. Scheduler selects ready sentrons
  2. D/S/C pipes execute in parallel
  3. Results committed to registers
  4. Telemetry updated
postcondition: 3 ops/cycle sustained

